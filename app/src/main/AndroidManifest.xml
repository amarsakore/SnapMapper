<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Screenshot via the system screen-capture API (asked for once, with consent). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: the small pill around the camera (you grant "Display over other apps"). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Optional: per-app actions read only which app is in front (you grant "Usage access"). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets the "Launch app" action list installed apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent helper that asks for one-time screen-capture consent. -->
        <activity
            android:name=".ProjectionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Holds the screen-capture session and saves screenshots. -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Device admin used only for the "Lock screen" action (force-lock policy). -->
        <receiver
            android:name=".LockAdminReceiver"
            android:exported="false"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- ColorOS binds this (Snap Key set to "Translate") and sends SINGLE_TAP / LONG_PRESS.
             Messages are only accepted from com.oplus.gesture; see KeyMessengerService. -->
        <service
            android:name="com.coloros.translate.ui.cube.KeyMessengerService"
            android:exported="true" />

        <!-- Some gesture app versions (8.6.0 on the Find X9) start this service on a long press... -->
        <service
            android:name="com.coloros.translate.ui.cube.LongPressService"
            android:exported="true"
            android:foregroundServiceType="shortService">
            <intent-filter>
                <action android:name="oplus.intent.action.GLOBAL_TRANSLATION" />
            </intent-filter>
        </service>

        <!-- ...and others start this activity. See-through; in front only for an instant. -->
        <activity
            android:name=".CircleToSearchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ColorOS starts this action on a long press of the Snap Key. -->
        <activity
            android:name="com.coloros.translate.ui.cube.LongPressActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="coloros.intent.action.translate.CUBE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
