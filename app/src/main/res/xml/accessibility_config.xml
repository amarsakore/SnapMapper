<?xml version="1.0" encoding="utf-8"?>
<!-- Used only to run actions (screenshot, lock screen, opening apps from the background).
     It doesn't filter keys or read screen content; Snap Key presses come from ColorOS.
     isAccessibilityTool declares this as a UI-control utility (like a button remapper), so the
     system and some apps don't treat it as a suspicious screen reader. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:isAccessibilityTool="true"
    android:notificationTimeout="1000"
    android:description="@string/service_description" />
